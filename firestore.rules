rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Upper bound on a single page, so a caller cannot page through an
    // unbounded result set. Adjust alongside any pagination in the client.
    const MAX_LIST_LIMIT = 200;

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The existing document belongs to the caller. Only valid for
    // get / delete / update — `resource` is undefined in list operations.
    function isOwnerDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // A create/write must stamp the caller's uid so ownership cannot be forged.
    function isOwnerWrite() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // For list operations the rules engine evaluates the QUERY, not each result.
    // Requiring an exact-equality filter on userId plus a bounded limit is what
    // keeps a user inside their own data: without the where() clause Firestore
    // would refuse the query anyway, and without the limit a caller could page
    // through an unbounded result set.
    function isOwnerQuery() {
      return isSignedIn()
             && request.query.limit != null
             && request.query.limit <= MAX_LIST_LIMIT
             && request.query.where("userId").isEqualTo(request.auth.uid);
    }

    // Public test doc for connection health check
    match /test/{testId} {
      allow get: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Leitner Folders
    //
    // NOTE: `resource` is NOT available in `list` rules — it is only defined
    // for get/delete/update. Querying `resource.data` here throws at runtime.
    // A list rule must instead verify the QUERY, which is the only thing the
    // client actually controls at that point. Every list below therefore
    // requires an explicit where("userId", "==", uid) plus a bounded limit,
    // so a user can neither read nor enumerate anyone else's documents.
    match /leitner_folders/{folderId} {
      allow get, delete: if isOwnerDoc();
      allow list: if isOwnerQuery();
      allow create: if isOwnerWrite() && isValidId(folderId);
      allow update: if isOwnerWrite() && isOwnerDoc() && isValidId(folderId);
    }

    // Leitner Cards
    match /leitner_cards/{cardId} {
      allow get, delete: if isOwnerDoc();
      allow list: if isOwnerQuery();
      allow create: if isOwnerWrite() && isValidId(cardId);
      allow update: if isOwnerWrite() && isOwnerDoc() && isValidId(cardId);
    }

    // Books
    match /books/{bookId} {
      allow get, delete: if isOwnerDoc();
      allow list: if isOwnerQuery();
      allow create: if isOwnerWrite() && isValidId(bookId);
      allow update: if isOwnerWrite() && isOwnerDoc() && isValidId(bookId);
    }

    // Sentence Learning Progress
    match /sentence_progress/{progressId} {
      allow get, delete: if isOwnerDoc();
      allow list: if isOwnerQuery();
      allow create: if isOwnerWrite() && isValidId(progressId);
      allow update: if isOwnerWrite() && isOwnerDoc() && isValidId(progressId);
    }

    // -------------------------------------------------------------------------
    // Phase 2 of the Supabase -> Firestore migration.
    //
    // The tables below are still served by Supabase and have NO Firestore
    // counterpart yet, so every path stays denied until each one is migrated.
    // This is deliberate: it fails closed instead of exposing partially
    // written data. See PROJECT_STATUS.md for the migration order.
    // -------------------------------------------------------------------------
    match /sentence_lab/{docId=**}              { allow read, write: if false; }
    match /sentence_categories/{docId=**}       { allow read, write: if false; }
    match /sentence_paths/{docId=**}            { allow read, write: if false; }
    match /book_chapters/{docId=**}             { allow read, write: if false; }
    match /paragraph_analyses/{docId=**}        { allow read, write: if false; }
    match /daily_quests/{docId=**}              { allow read, write: if false; }
    match /user_gamification/{docId=**}         { allow read, write: if false; }
    match /user_achievements/{docId=**}         { allow read, write: if false; }
    match /news_sources/{docId=**}              { allow read, write: if false; }
    match /news_folders/{docId=**}              { allow read, write: if false; }
    match /news_articles/{docId=**}             { allow read, write: if false; }
    match /news_digests/{docId=**}              { allow read, write: if false; }
    match /scenario_sessions/{docId=**}         { allow read, write: if false; }
    match /scenario_saved_sentences/{docId=**}  { allow read, write: if false; }
    match /sentence_flags/{docId=**}            { allow read, write: if false; }
    match /news_blocked_domains/{docId=**}      { allow read, write: if false; }
  }
}
